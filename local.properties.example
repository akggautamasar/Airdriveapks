# Copy this file to local.properties (which is gitignored) for local Android Studio builds.
# sdk.dir is normally written automatically by Android Studio on first sync.

sdk.dir=/path/to/Android/sdk

# Telegram credentials for local builds only. Get your own at https://my.telegram.org.
# Never commit real values — GitHub Actions builds instead use repository secrets
# TELEGRAM_API_ID / TELEGRAM_API_HASH (see README).
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
